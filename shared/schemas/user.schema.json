{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "user.schema.json",
  "title": "User",
  "description": "User entity",
  "allOf": [
    { "$ref": "base-item.schema.json" },
    {
      "type": "object",
      "properties": {
        "email": {
          "type": "string",
          "description": "User email"
        },
        "role": {
          "$ref": "enums.schema.json#/definitions/UserRole"
        },
        "createdAt": {
          "type": "string",
          "description": "Creation timestamp"
        }
      },
      "required": ["email", "role", "createdAt"]
    }
  ]
}