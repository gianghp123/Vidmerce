{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "asset.schema.json",
  "title": "Asset",
  "description": "Asset entity for product information",
  "allOf": [
    { "$ref": "base-item.schema.json" },
    {
      "type": "object",
      "properties": {
        "name": {
          "type": "string",
          "description": "Product name"
        },
        "price": {
          "type": "number",
          "description": "Product price"
        },
        "productUrl": {
          "type": "string",
          "format": "uri",
          "description": "Product URL"
        },
        "images": {
          "type": "array",
          "items": {
            "$ref": "image.schema.json"
          },
          "description": "Product images"
        },
        "status": {
          "$ref": "enums.schema.json#/definitions/AssetStatus"
        },
        "imageCount": {
          "type": "integer",
          "minimum": 0,
          "description": "Number of images"
        },
        "createdAt": {
          "type": "string",
          "description": "Creation timestamp"
        }
      },
      "required": ["name", "price", "productUrl", "status", "imageCount", "createdAt"]
    }
  ]
}