{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "campaign.schema.json",
  "title": "Campaign",
  "description": "Campaign entity",
  "allOf": [
    { "$ref": "base-item.schema.json" },
    {
      "type": "object",
      "properties": {
        "assetId": {
          "type": "string",
          "description": "Associated asset ID"
        },
        "status": {
          "$ref": "enums.schema.json#/definitions/CampaignStatus"
        },
        "storyboard": {
          "$ref": "storyboard.schema.json",
          "description": "Campaign storyboard"
        },
        "createdAt": {
          "type": "string",
          "description": "Creation timestamp"
        },
        "updatedAt": {
          "type": "string",
          "description": "Last update timestamp"
        }
      },
      "required": ["assetId", "status", "createdAt"]
    }
  ]
}