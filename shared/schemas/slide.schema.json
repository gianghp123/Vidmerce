{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "slide.schema.json",
  "title": "Slide",
  "description": "Slide for storyboard",
  "type": "object",
  "properties": {
    "slideNumber": {
      "type": "integer",
      "minimum": 1,
      "description": "Slide number"
    },
    "imageRole": {
      "$ref": "enums.schema.json#/definitions/ImageRole"
    },
    "s3Key": {
      "type": "string",
      "description": "S3 key for image"
    },
    "overlayText": {
      "type": "string",
      "description": "Overlay text on image"
    }
  },
  "required": ["slideNumber", "imageRole", "s3Key"]
}